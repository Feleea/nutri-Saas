# Dono do schema (migrations, seed, importação TACO/TBCA). NUNCA usar na aplicação.
DATABASE_URL_OWNER=postgresql://suasnutri_owner:owner_dev_pw@localhost:5432/suasnutri
# Aplicação (nutricionistas): sujeita ao RLS
DATABASE_URL=postgresql://suasnutri_app:app_dev_pw@localhost:5432/suasnutri
# Painel do dono: só enxerga tabelas de conta, cobrança e contadores
DATABASE_URL_ADMIN=postgresql://suasnutri_admin:admin_dev_pw@localhost:5432/suasnutri
# Chave mestra de 32 bytes em base64; também embrulha chaves de dados clínicas por tenant.
# Gerar uma vez e preservar no gerenciador de segredos/backup de segredos: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Camada web
APP_BASE_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
GATEWAY_WEBHOOK_SECRET=
MAIL_DRIVER=console   # memory | console (só dev); produção exige provedor real
JOB_SECRET=            # segredo do agendador (cron) que chama /api/jobs/*
